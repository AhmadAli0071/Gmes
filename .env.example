# ── Frontend ────────────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls (suggest-a-message).
# The browser must NOT see this key — the server proxies AI calls (Sprint 3).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Canonical origin used in SEO tags (src/data/seoContent.ts) — change it when
# the real domain lands.
SITE_URL="https://gems.example.com"

# ── Server (npm run server) ────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
MONGODB_URI="mongodb://127.0.0.1:27017/gems"
SESSION_DAYS="30"
# true = cookies only over https (production). false lets you test on http://LAN_IP.
COOKIE_SECURE="false"
# Origin allowed to receive cookies / be linked from (dev Vite server).
CLIENT_URL="http://localhost:8080"
# Where uploaded photos/voice notes land (relative to the working directory).
UPLOADS_DIR="uploads"

# ── Sprint 2+ ──────────────────────────────────────────────────────────────
# Google Identity Services client id (google login).
GOOGLE_CLIENT_ID=""
# Stripe (checkout for paid plans).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
